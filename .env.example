# Server: keep loopback-only and expose it through an HTTPS outbound tunnel.
HOST=127.0.0.1
PORT=4310
PUBLIC_ORIGIN=
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
TRUST_PROXY=true

# Local Codex app-server. It uses this Mac's existing `codex login` session.
CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high
# This HTTPS-only provider avoids the repeated WebSocket retry seen on this Mac.
CODEX_MODEL_PROVIDER=openai_http
CHATGPT_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_REQUEST_TIMEOUT_MS=1200000
CODEX_MAX_CONCURRENT_TURNS=40

# Data. Relative paths resolve from this repository.
DATA_DIR=.data
DATABASE_PATH=.data/harness.sqlite
WORKSPACES_ROOT=.data/workspaces

# Per-user defaults. A super admin can change network access and quotas later.
DEFAULT_NETWORK_ACCESS=false
DEFAULT_MAX_PROJECTS=10
DEFAULT_MAX_STORAGE_BYTES=2147483648
DEFAULT_MAX_CONCURRENT_TURNS=40
COMMAND_TIMEOUT_MS=120000
COMMAND_MAX_OUTPUT_BYTES=1048576
FILE_MAX_BYTES=10485760
UPLOAD_MAX_BYTES=52428800

# First boot only. Prefer `./bin/create-super-admin.sh` instead of leaving a
# plaintext password here. If no admin exists and both values are set, the
# account is created once and these values are ignored on later boots.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public tunnel: quick, named, tailscale, or off.
PUBLIC_TUNNEL_MODE=quick
PUBLIC_URL=
PUBLIC_TUNNEL_TOKEN_FILE=.data/cloudflare-tunnel.token
CLOUDFLARED_BIN=.tools/cloudflared
CLOUDFLARED_PROTOCOL=auto
TAILSCALE_BIN=/usr/local/bin/tailscale
